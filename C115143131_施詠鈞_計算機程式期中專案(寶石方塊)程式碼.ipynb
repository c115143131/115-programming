    "### 1. 座標測量工具\n",
    "請先執行此區塊取得您螢幕的正確 `BOARD_X` 與 `BOARD_Y`。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pyautogui\n",
    "import time\n",
    "\n",
    "print(\"【座標測量工具】啟動...\")\n",
    "try:\n",
    "    while True:\n",
    "        x, y = pyautogui.position()\n",
    "        print(f\"目前滑鼠座標: X: {x}, Y: {y}\", end=\"\\r\")\n",
    "        time.sleep(0.1)\n",
    "except KeyboardInterrupt:\n",
    "    print(\"\\n測量結束。\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 2. AI 視覺判定除錯圖 (Visual Debugger)\n",
    "執行此區塊，會截圖並印出 AI 實際看到且判定出的顏色。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import cv2\n",
    "import numpy as np\n",
    "import pyautogui\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "region = (BOARD_X, BOARD_Y, COLS * TILE_SIZE, ROWS * TILE_SIZE)\n",
    "screenshot = pyautogui.screenshot(region=region)\n",
    "img_rgb = np.array(screenshot)\n",
    "\n",
    "board = capture_board() \n",
    "\n",
    "plt.figure(figsize=(10, 10))\n",
    "plt.imshow(img_rgb)\n",
    "\n",
    "for r in range(ROWS):\n",
    "    for c in range(COLS):\n",
    "        color_text = board[r][c]\n",
    "        text_x = c * TILE_SIZE + TILE_SIZE / 2\n",
    "        text_y = r * TILE_SIZE + TILE_SIZE / 2\n",
    "        \n",
    "        plt.text(text_x, text_y, color_text, \n",
    "                 color='white', backgroundcolor='black',\n",
    "                 ha='center', va='center', fontsize=9)\n",
    "\n",
    "plt.title(\"AI 視覺判定除錯圖\")\n",
    "plt.axis('off')\n",
    "plt.show()\n"
   ]
