   "source": [
    "## 寶石方塊 AI - 極限效能與絕對精準版\n",
    "此版本已經整合了以下最新功能：\n",
    "1. **極限中心採樣 (margin=0.40)**：完全無視寶石邊緣發光特效。\n",
    "2. **嚴格紅橘分離 (Strict HSV)**：提高飽和度門檻，並拉開紅橘色相緩衝區。\n",
    "3. **高標準判定門檻 (Threshold=45%)**：寧可漏判也不誤判，防卡死。\n",
    "4. **光影均勻化 (CLAHE) & 複合形態學 (Close+Open)**：穩定亮度與去空洞雜訊。\n",
    "5. **極速操作設定 (Speed Up)**：縮短 pyautogui 延遲與等待動畫的時間。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import cv2\n",
    "import numpy as np\n",
    "import pyautogui\n",
    "import time\n",
    "import random\n",
    "from copy import deepcopy\n",
    "\n",
    "# ==========================================\n",
    "# 系統與安全設定 (極速版)\n",
    "# ==========================================\n",
    "pyautogui.FAILSAFE = True\n",
    "pyautogui.PAUSE = 0.02  # 加快全域滑鼠操作延遲\n",
    "\n",
    "# ==========================================\n",
    "# 遊戲盤面座標\n",
    "# ==========================================\n",
    "BOARD_X = 500      \n",
    "BOARD_Y = 300      \n",
    "TILE_SIZE = 60     \n",
    "ROWS = 8\n",
    "COLS = 8\n",
    "\n",
    "# ==========================================\n",
    "# 精準 HSV 顏色範圍設定 (嚴格紅橘分離版)\n",
    "# ==========================================\n",
    "COLOR_RANGES = {\n",
    "    'red': ([0, 180, 120], [5, 255, 255]),      # 嚴格紅色\n",
    "    'orange': ([12, 150, 150], [22, 255, 255]), # 拉開與紅色的距離\n",
    "    'yellow': ([26, 120, 150], [35, 255, 255]),\n",
    "    'green': ([36, 100, 100], [85, 255, 255]),\n",
    "    'blue': ([90, 150, 150], [130, 255, 255]),\n",
    "    'purple': ([135, 100, 100], [165, 255, 255]),\n",
    "    'white': ([0, 0, 150], [180, 50, 255])\n",
    "}\n",
    "\n",
    "def clamp_coords(x, y):\n",
    "    min_x = BOARD_X\n",
    "    max_x = BOARD_X + (COLS * TILE_SIZE) - 1\n",
    "    min_y = BOARD_Y\n",
    "    max_y = BOARD_Y + (ROWS * TILE_SIZE) - 1\n",
    "    return max(min_x, min(x, max_x)), max(min_y, min(y, max_y))\n",
    "\n",
    "def capture_board():\n",
    "    region = (BOARD_X, BOARD_Y, COLS * TILE_SIZE, ROWS * TILE_SIZE)\n",
    "    screenshot = pyautogui.screenshot(region=region)\n",
    "    img_bgr = cv2.cvtColor(np.array(screenshot), cv2.COLOR_RGB2BGR)\n",
    "    \n",
    "    # 1. 均勻化亮度與對比 (CLAHE)\n",
    "    lab = cv2.cvtColor(img_bgr, cv2.COLOR_BGR2LAB)\n",
    "    l, a, b = cv2.split(lab)\n",
    "    clahe = cv2.createCLAHE(clipLimit=2.0, tileGridSize=(8, 8))\n",
    "    l = clahe.apply(l)\n",
    "    img_bgr = cv2.cvtColor(cv2.merge((l, a, b)), cv2.COLOR_LAB2BGR)\n",
    "    \n",
    "    # 2. 輕微高斯模糊\n",
    "    img_bgr = cv2.GaussianBlur(img_bgr, (5, 5), 0)\n",
    "    img_hsv = cv2.cvtColor(img_bgr, cv2.COLOR_BGR2HSV)\n",
    "    \n",
    "    board = [['unknown' for _ in range(COLS)] for _ in range(ROWS)]\n",
    "    \n",
    "    for r in range(ROWS):\n",
    "        for c in range(COLS):\n",
    "            # 極限中心採樣 (只取正中心 20% 面積)\n",
    "            margin = int(TILE_SIZE * 0.40)\n",
    "            roi_hsv = img_hsv[r*TILE_SIZE+margin : (r+1)*TILE_SIZE-margin, \n",
    "                              c*TILE_SIZE+margin : (c+1)*TILE_SIZE-margin]\n",
    "            roi_bgr = img_bgr[r*TILE_SIZE+margin : (r+1)*TILE_SIZE-margin, \n",
    "                              c*TILE_SIZE+margin : (c+1)*TILE_SIZE-margin]\n",
    "            \n",
    "            best_color = 'unknown'\n",
    "            max_pixels = 0\n",
    "            \n",
    "            for color_name, (lower, upper) in COLOR_RANGES.items():\n",
    "                lower_np = np.array(lower, dtype=np.uint8)\n",
    "                upper_np = np.array(upper, dtype=np.uint8)\n",
    "                mask = cv2.inRange(roi_hsv, lower_np, upper_np)\n",
    "                \n",
    "                # 紅色橫跨 HSV 兩端\n",
    "                if color_name == 'red':\n",
    "                    mask2 = cv2.inRange(roi_hsv, np.array([170, 180, 120], dtype=np.uint8), np.array([180, 255, 255], dtype=np.uint8))\n",
    "                    mask = cv2.bitwise_or(mask, mask2)\n",
    "                \n",
    "                # 複合形態學：先閉運算填補空洞，再開運算去雜訊\n",
    "                kernel_close = np.ones((5, 5), np.uint8)\n",
    "                kernel_open = np.ones((3, 3), np.uint8)\n",
    "                mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, kernel_close)\n",
    "                mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, kernel_open)\n",
    "                    \n",
    "                pixel_count = cv2.countNonZero(mask)\n",
    "                if pixel_count > max_pixels:\n",
    "                    max_pixels = pixel_count\n",
    "                    best_color = color_name\n",
    "            \n",
    "            total_area = roi_hsv.shape[0] * roi_hsv.shape[1]\n",
    "            # 嚴格判定門檻：45%\n",
    "            if max_pixels < (total_area * 0.45):\n",
    "                best_color = 'unknown'\n",
    "            \n",
    "            # 特殊寶石偵測保留 (透過邊緣密度)\n",
    "            gray_roi = cv2.cvtColor(roi_bgr, cv2.COLOR_BGR2GRAY)\n",
    "            edges = cv2.Canny(gray_roi, 50, 150)\n",
    "            edge_density = cv2.countNonZero(edges)\n",
    "            \n",
    "            if edge_density > 80 and best_color != 'unknown':\n",
    "                best_color += \"_special\"\n",
    "                \n",
    "            board[r][c] = best_color\n",
    "            \n",
    "    return board\n",
    "\n",
    "def calculate_score(board):\n",
    "    score = 0\n",
    "    def get_base_color(gem_name):\n",
    "        return gem_name.replace('_special', '') if gem_name != 'unknown' else 'unknown'\n",
    "\n",
    "    for r in range(ROWS):\n",
    "        c = 0\n",
    "        while c < COLS - 2:\n",
    "            c1, c2, c3 = get_base_color(board[r][c]), get_base_color(board[r][c+1]), get_base_color(board[r][c+2])\n",
    "            if c1 != 'unknown' and c1 == c2 == c3:\n",
    "                length = 3\n",
    "                has_special = ('_special' in board[r][c] or '_special' in board[r][c+1] or '_special' in board[r][c+2])\n",
    "                while c + length < COLS and c1 == get_base_color(board[r][c+length]):\n",
    "                    if '_special' in board[r][c+length]: has_special = True\n",
    "                    length += 1\n",
    "                base_score = {3: 100, 4: 500}.get(length, 1000)\n",
    "                score += (base_score * 3) if has_special else base_score\n",
    "                c += length\n",
    "            else:\n",
    "                c += 1\n",
    "                \n",
    "    for c in range(COLS):\n",
    "        r = 0\n",
    "        while r < ROWS - 2:\n",
    "            c1, c2, c3 = get_base_color(board[r][c]), get_base_color(board[r+1][c]), get_base_color(board[r+2][c])\n",
    "            if c1 != 'unknown' and c1 == c2 == c3:\n",
    "                length = 3\n",
    "                has_special = ('_special' in board[r][c] or '_special' in board[r+1][c] or '_special' in board[r+2][c])\n",
    "                while r + length < ROWS and c1 == get_base_color(board[r+length][c]):\n",
    "                    if '_special' in board[r+length][c]: has_special = True\n",
    "                    length += 1\n",
    "                base_score = {3: 100, 4: 500}.get(length, 1000)\n",
    "                score += (base_score * 3) if has_special else base_score\n",
    "                r += length\n",
    "            else:\n",
    "                r += 1\n",
    "                \n",
    "    return score\n",
    "\n",
    "def find_all_moves(board):\n",
    "    moves = []\n",
    "    directions = [(0, 1), (1, 0)]\n",
    "    \n",
    "    for r in range(ROWS):\n",
    "        for c in range(COLS):\n",
    "            for dr, dc in directions:\n",
    "                nr, nc = r + dr, c + dc\n",
    "                if nr < ROWS and nc < COLS:\n",
    "                    if board[r][c] == board[nr][nc] or board[r][c] == 'unknown' or board[nr][nc] == 'unknown':\n",
    "                        continue\n",
    "                        \n",
    "                    temp_board = deepcopy(board)\n",
    "                    temp_board[r][c], temp_board[nr][nc] = temp_board[nr][nc], temp_board[r][c]\n",
    "                    \n",
    "                    score = calculate_score(temp_board)\n",
    "                    if score > 0:\n",
    "                        depth_weight = (r + nr) * 5\n",
    "                        total_score = score + depth_weight\n",
    "                        moves.append((total_score, ((r, c), (nr, nc))))\n",
    "                            \n",
    "    moves.sort(key=lambda x: x[0], reverse=True)\n",
    "    return [m[1] for m in moves]\n",
    "\n",
    "def execute_move(move):\n",
    "    (r1, c1), (r2, c2) = move\n",
    "    raw_x1 = BOARD_X + c1 * TILE_SIZE + TILE_SIZE // 2\n",
    "    raw_y1 = BOARD_Y + r1 * TILE_SIZE + TILE_SIZE // 2\n",
    "    raw_x2 = BOARD_X + c2 * TILE_SIZE + TILE_SIZE // 2\n",
    "    raw_y2 = BOARD_Y + r2 * TILE_SIZE + TILE_SIZE // 2\n",
    "    \n",
    "    x1, y1 = clamp_coords(raw_x1, raw_y1)\n",
    "    x2, y2 = clamp_coords(raw_x2, raw_y2)\n",
    "    \n",
    "    pyautogui.click(x1, y1)\n",
    "    time.sleep(0.05) # 極速點擊間隔\n",
    "    pyautogui.click(x2, y2)\n",
    "    print(f\"[執行] 點擊交換 ({r1},{c1}) 與 ({r2},{c2})\")\n",
    "\n",
    "def anti_stuck():\n",
    "    print(\"[警告] 偵測不到可消除的組合，啟動隨機點擊防卡死...\")\n",
    "    raw_rx = BOARD_X + random.randint(0, COLS-1) * TILE_SIZE + TILE_SIZE // 2\n",
    "    raw_ry = BOARD_Y + random.randint(0, ROWS-1) * TILE_SIZE + TILE_SIZE // 2\n",
    "    rx, ry = clamp_coords(raw_rx, raw_ry)\n",
    "    pyautogui.click(rx, ry)\n",
    "    time.sleep(0.5) # 防卡死等待稍微短一點\n",
    "\n",
    "def is_same_board(b1, b2):\n",
    "    if b1 is None or b2 is None:\n",
    "        return False\n",
    "    same_count = 0\n",
    "    for r in range(ROWS):\n",
    "        for c in range(COLS):\n",
    "            c1 = b1[r][c].replace('_special', '')\n",
    "            c2 = b2[r][c].replace('_special', '')\n",
    "            if c1 == c2:\n",
    "                same_count += 1\n",
    "    return same_count >= 58\n",
    "\n",
    "def main():\n",
    "    print(\"=== 極限效能與絕對精準版 AI 啟動 ===\")\n",
    "    time.sleep(3)\n",
    "    \n",
    "    consecutive_stuck = 0\n",
    "    previous_board = None\n",
    "    failed_moves = set()\n",
    "\n",
    "    while True:\n",
    "        board = capture_board()\n",
    "        \n",
    "        if is_same_board(board, previous_board):\n",
    "            print(\"[提示] 盤面未改變，剛剛的移動無效，嘗試清單下一個。\")\n",
    "        else:\n",
    "            failed_moves = set()\n",
    "            previous_board = board\n",
    "\n",
    "        all_moves = find_all_moves(board)\n",
    "        valid_moves = [m for m in all_moves if m not in failed_moves]\n",
    "        \n",
    "        if valid_moves:\n",
    "            consecutive_stuck = 0\n",
    "            best_move = valid_moves[0]\n",
    "            failed_moves.add(best_move)\n",
    "            execute_move(best_move)\n",
    "            time.sleep(0.3) # 縮短動畫等待時間\n",
    "        else:\n",
    "            consecutive_stuck += 1\n",
    "            anti_stuck()\n",
    "            if consecutive_stuck >= 5:\n",
    "                print(\"[中止] 連續多次無法辨識或無步可走，腳本自動停止。\")\n",
    "                break\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    main()\n"
   ]
  },
